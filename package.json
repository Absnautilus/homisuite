{
  "name": "homisuite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "modules/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:db": "supabase db reset && supabase test db",
    "check:boundaries": "node --test scripts/ci/lib/workspaces.test.mjs && node scripts/ci/check-workspace-boundaries.mjs",
    "check:circular": "node scripts/ci/check-circular-deps.mjs",
    "check:dedupe": "node scripts/ci/check-dependency-dedupe.mjs"
  },
  "devDependencies": {
    "eslint": "^9.19.0",
    "typescript": "~5.7.0",
    "vite": "^7.1.5"
  }
}
