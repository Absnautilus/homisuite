# Copy to .env and fill in real values. Never commit .env.
# Only needed to run the Core SDK against a real (local or hosted) Supabase
# project — the unit tests (`npm test`) mock the client and need none of this.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# The early-access-signup Edge Function (supabase/functions/early-access-signup)
# does NOT read its environment from this file -- Edge Functions get their
# env from the Supabase project's own secrets (`supabase secrets set`), not
# from a repo .env. See docs/early-access.md's "Environment variables"
# section for the full list (EARLY_ACCESS_ALLOWED_ORIGINS,
# EARLY_ACCESS_NOTIFICATION_TO, EARLY_ACCESS_CONFIRMATION_FROM, EMAIL_FROM,
# EMAIL_PROVIDER, RESEND_API_KEY) and how to configure them.
